{
  "name": "staygreen",
  "version": "0.1.0",
  "private": true,
  "description": "Staygreen: monitoring for apps builders ship with coding agents. Next.js on Clerk and Supabase.",
  "scripts": {
    "cli:build": "npm --prefix packages/staygreen run build",
    "cli:contract": "esbuild scripts/generate-mcp-contract.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/dist/generate-mcp-contract.mjs --log-level=warning && node scripts/dist/generate-mcp-contract.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "golive:check": "vitest run --project golive",
    "test:live": "vitest run --project live",
    "probe:build": "esbuild probe/main.ts probe/bench.ts --bundle --platform=node --target=node22 --external:pg-native --outdir=probe/dist --log-level=warning",
    "probe:bench": "npm run probe:build && node probe/dist/bench.js",
    "e2e": "playwright test -c playwright.config.ts",
    "e2e:auth": "playwright test -c playwright.auth.config.ts",
    "gate": "npm run typecheck && npm test && npm run e2e && npm run e2e:auth"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.11",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "pg-copy-streams": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tldts": "6.1.86",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.43",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "license": "FSL-1.1-MIT"
}
