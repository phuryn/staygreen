# secrets
.staygreen/
.env
.env.*
!.env.example
# wrangler's local secrets file (ingest/)
.dev.vars
# Supabase MCP config (carries your project ref; written by `claude mcp add --scope project`)
/.mcp.json

# node / next
# next-env.d.ts is regenerated by every next command and its contents differ
# between `next dev` and `next build`, so tracking it only dirties the tree.
next-env.d.ts
node_modules/
.next/
# any dist dir a `NEXT_DIST_DIR` build writes — the e2e suite uses its own so it
# never fights a `next dev` you have open
.next-*/
out/
dist/
coverage/
*.log
npm-debug.log*

# wrangler's local state and build output (ingest/)
.wrangler/

# supabase local
supabase/.temp/
supabase/.branches/

# agent / editors
.claude/settings.local.json

# os / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# static audit reports (pm-ai-shipping writes them here; RELEASE.md § 1)
reports/

# test artifacts
.screens/
e2e-artifacts/
test-results/
playwright-report/
*.tsbuildinfo
# fixture state a browser suite's setup writes to disk, never committed
tests/e2e/.seed.json
# the authenticated suite's test accounts, written by its global setup
tests/e2e/.auth.json
# and the sessions its sign-in project saves
tests/e2e/.auth/

# python bytecode
__pycache__/

# Taste skill working files (design/README.md § Design skills)
.taste-skill/

# scratch (screenshots and throwaway files)
Temp/
shots/
