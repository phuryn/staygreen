# /etc/staygreen-probe.env: one probe's variables, read by staygreen-probe.service.
#   install -m 600 -o root -g root probe.env /etc/staygreen-probe.env
# systemd EnvironmentFile syntax, not shell: KEY="value" on its own line, no `export`, no
# expansion, no comment after a value. Inside the quotes write \" for a quote, \\ for a
# backslash. Each box gets its own file; PROBE_PEER_SECRET and CREDENTIALS_KEY are the same on
# every box. Generate a 32-byte base64url secret with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"

# Postgres, as this probe's own login: a member of the `probe` group role and nothing else.
# One login per probe, made by the database owner with a hex password (openssl rand -hex 24),
# which needs no escaping in this statement or in the URL below:
#   create role <login> login inherit nosuperuser nocreatedb nocreaterole noreplication nobypassrls password '<generated>';
#   grant probe to <login>;
# On Supabase use the direct host, db.<project-ref>.supabase.co:5432, reached over IPv6.
# sslmode=require&uselibpqcompat=true encrypts without checking the server's certificate; to
# check it, use sslmode=verify-full with Supabase's CA file as sslrootcert instead.
DATABASE_URL="postgres://<login>:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true"

# A stable id, unique across the fleet, in the form <location>-<letter> (tor1-a): the watchdog
# names a probe's city from the part before the first dash. Lowercase letters, digits, dashes.
PROBE_ID="<probe-id>"

# The scheduler's location: tor1, sfo3 or fra1. These ids are code (src/lib/plans.ts); a box
# elsewhere takes the nearest one, or the location model and its tests change together.
PROBE_LOCATION="<location>"

# "true" for a probe that checks Builder-plan monitors only; must be "true" for fra1.
PROBE_BUILDER_ONLY="false"

# How the other probes reach this one: http://<this box's public IPv4 address>:7070, no path.
# setup.sh opens 7070 to the fleet's addresses only, and peers sign every request.
PROBE_URL="http://<this-box-address>:7070"

# The port the probe listens on, on every interface. Change PROBE_URL and the firewall with it.
PROBE_PORT="7070"

# The HMAC secret every probe in the fleet shares: 32 to 512 characters, no line breaks.
PROBE_PEER_SECRET="<shared-peer-secret>"

# The app's CREDENTIALS_KEY, the same value: it opens the monitors' sealed headers.
# 32 random bytes, base64url (43 characters).
CREDENTIALS_KEY="<app-credentials-key>"

# Optional: comma-separated workspace ids, the only ones this probe checks. Empty checks every
# workspace; a development probe can use it to stay off test data.
PROBE_WORKSPACES=""

# SHA-256 of the main.js this box runs, 64 lowercase hex digits; /health reports it. Renew it
# with every bundle you install:
#   sha256sum probe/dist/main.js
PROBE_RELEASE="<sha256-of-main.js>"

# Optional: libuv's thread pool, which every check's DNS lookup waits on. The probe sets 64
# when this is unset; uncomment only to override.
#UV_THREADPOOL_SIZE="64"
