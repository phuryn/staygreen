# /etc/staygreen-edge.env: the status renderer's variables, read by staygreen-edge.service.
#   install -m 600 -o root -g root edge.env /etc/staygreen-edge.env
# systemd EnvironmentFile syntax, as in probe.env.example: KEY="value" on its own line, no
# `export`, no expansion. The unit itself sets NODE_ENV=production.

# Your status host: the name Caddy serves and Cloudflare proxies, lowercase, no scheme or path.
# The same value as the app's NEXT_PUBLIC_STATUS_HOST. Unset, the renderer falls back to the
# hosted service's host, so always set it.
EDGE_STATUS_HOST="status.example.com"

# Postgres, as the edge's own login: a member of the `edge` group role and nothing else.
#   create role <login> login inherit nosuperuser nocreatedb nocreaterole noreplication nobypassrls password '<generated>';
#   grant edge to <login>;
# The renderer holds a LISTEN connection: use a direct or session connection, never transaction
# pooling. TLS parameters as in probe.env.example.
EDGE_DATABASE_URL="postgres://<login>:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true"

# The id of the Cloudflare zone that holds the status host, 32 hex digits. The renderer purges
# that host's page, summary and badge URLs from Cloudflare's cache when a page changes.
EDGE_ZONE_ID="<zone-id>"

# A Cloudflare API token with Cache Purge on that zone and nothing else; never a token that can
# edit DNS or rules.
EDGE_PURGE_TOKEN="<purge-token>"

# 64 lowercase hex digits naming the five files in /opt/staygreen-edge; /health reports it.
# Renew it with every build. From the folder that holds the five built files:
#   for f in main.js status.css w.js icon.svg Switzer-Variable.woff2; do printf %s "$f"; cat "$f"; done | sha256sum
EDGE_RELEASE="<release-hash>"

# The app's EDGE_CONTROL_SECRET, the same value: the app uses it to withdraw a page that turns
# private before saving it. 32 random bytes, base64url.
EDGE_CONTROL_SECRET="<edge-control-secret>"
